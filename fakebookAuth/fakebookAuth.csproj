<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="schema.sql" LogicalName="fakebookAuth.Database.schema.sql" />
      <EmbeddedResource Include="migrations\*.sql" LogicalName="fakebookAuth.Database.Migrations.%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
      <PackageReference Include="Dapper" Version="2.1.79" />
      <PackageReference Include="HotChocolate.AspNetCore" Version="16.0.1" />
      <PackageReference Include="HotChocolate.AspNetCore.CommandLine" Version="16.1.3" />
      <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
      <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
      <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
      <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
      <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
      <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
      <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="StackExchange.Redis" Version="3.0.0" />
    </ItemGroup>

</Project>
